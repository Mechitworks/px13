From 551fd149df4453aa0ba2ee4d8067416b8a9a40be Mon Sep 17 00:00:00 2001
From: distsystem <dev@dist.systems>
Date: Sat, 10 Oct 2026 16:44:26 +0200
Subject: [PATCH 17/19] drm/amdgpu/vpe: keep DPM0 idle-gate on Strix Halo PMFW
 100.6.0

Signed-off-by: distsystem <dev@dist.systems>
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_vpe.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vpe.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_vpe.c
index 7bf74ff93..72cc3928d 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vpe.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vpe.c
@@ -331,7 +331,14 @@ static bool vpe_need_dpm0_at_power_down(struct amdgpu_device *adev)
 {
 	switch (amdgpu_ip_version(adev, VPE_HWIP, 0)) {
 	case IP_VERSION(6, 1, 1):
-		return adev->pm.fw_version < 0x0a640500;
+		/*
+		 * PX13 (Strix Halo) ships SMU PMFW 100.6.0 (pm.fw_version
+		 * 0x0a640600), >= upstream's 0x0a640500 gate, yet still wedges
+		 * the SMU on PowerDownVpe after resume - the firmware check
+		 * wrongly assumes >= 0x0a640500 is fixed. Force the DPM0 wait
+		 * on this VPE regardless of PMFW version.
+		 */
+		return true;
 	default:
 		return false;
 	}
-- 
